# Local standalone example only. Never deploy these placeholder secrets.
HOST=127.0.0.1
PORT=8787
WORKSPACE_ROOT=./workspace
MCP_DATA_ROOT=./.chatgpt-mcp

# Configure a real HTTPS origin to enable OAuth and the web admin console.
PUBLIC_BASE_URL=https://your-mcp.example.com
MCP_OWNER_PASSWORD=REPLACE_WITH_LONG_RANDOM_OAUTH_PASSWORD
MCP_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_ADMIN_PASSWORD

# Use the callback origin shown by your MCP client.
OAUTH_REDIRECT_ORIGINS=https://chatgpt.com
FILE_DOWNLOAD_ORIGINS=https://files.oaiusercontent.com,https://*.blob.core.windows.net
HTTP_ALLOWED_ORIGINS=

MAX_FILE_BYTES=536870912
MAX_RESOURCE_BYTES=8388608
MAX_JOBS=4
# DESKTOP_COMMANDER_COMMAND=["node","/opt/desktop-commander/dist/index.js"]
# EXECUTION_UID=990
# EXECUTION_GID=988

# Core is the default tool profile; interactive adds five DC terminal tools.
MCP_TOOL_PROFILE=core
